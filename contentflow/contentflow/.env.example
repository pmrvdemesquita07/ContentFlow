# --- Database (Prisma) ---
# From your Supabase project: Project Settings -> Database -> Connection string
# DATABASE_URL: the pooled connection (port 6543, "Transaction" mode) - used by the app at runtime.
# DIRECT_URL: the direct connection (port 5432) - used only for running migrations.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# --- Supabase (Auth + Storage) ---
# From your Supabase project: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Anthropic (AI Assistants: captions, reply suggestions, briefing drafts) ---
# From https://platform.claude.com -> API Keys
ANTHROPIC_API_KEY="sk-ant-xxxxx"

# --- Instagram OAuth (Social Hub) ---
# From developers.facebook.com -> your app -> Instagram -> API setup
INSTAGRAM_APP_ID="000000000000000"
INSTAGRAM_APP_SECRET="your-instagram-app-secret"

# --- TikTok OAuth (Social Hub) ---
# From developers.tiktok.com -> your app -> Manage apps
TIKTOK_CLIENT_KEY="awxxxxxxxxxxxxxx"
TIKTOK_CLIENT_SECRET="your-tiktok-client-secret"

# --- Stripe (billing) ---
# Secret key and webhook signing secret from dashboard.stripe.com
STRIPE_SECRET_KEY="sk_test_xxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxx"
# Price IDs for the two paid plans
STRIPE_PRICE_PRO="price_xxxxx"
STRIPE_PRICE_STUDIO="price_xxxxx"

# --- Email (scheduled report delivery) ---
RESEND_API_KEY="re_xxxxx"
REPORTS_FROM_EMAIL="reports@yourdomain.com"

# --- Scheduled jobs ---
# Required. The /api/cron/* routes reject every request without this bearer
# token, so leaving it unset disables the cron jobs rather than exposing them.
CRON_SECRET="a-long-random-string"

# --- Public site URL (OAuth redirects, shareable report links) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
